# Secrets — never commit
.env
.env.local
*.pem
*.key

# Dependencies
node_modules/

# CRE build artifacts
*.wasm
*.wasm.br
dist/
build/

# OS
.DS_Store

# CRE build temp
.cre_build_tmp.js

# CRE deploy artifact
binary.wasm.br.b64
.playwright-mcp/

# Next.js. Parallel test stacks each build into their own dist dir via NEXT_DIST_DIR.
.next/
.next-*/
out/
next-env.d.ts

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Local database and chain state
backend/data/
*.db
*.db-shm
*.db-wal
anvil.log
deployments.local.json

# Logs
*.log
logs/

# Playwright: the browser runs are reproducible, their artefacts are not worth carrying.
**/test-results/
**/playwright-report/
frontend/e2e/.artifacts/

# The global gitignore excludes [Ss]cripts; this project keeps script directories.
!**/scripts/
!**/scripts/**

# The global gitignore excludes [Ll]ib, which matches source directories named lib/.
# Foundry's contracts/lib is a real dependency dir and stays excluded (above).
!**/src/lib/
!**/src/lib/**
