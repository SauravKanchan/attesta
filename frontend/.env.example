# Backend base URL. The client appends /api to this.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Privy ──────────────────────────────────────────────────
# Dashboard -> Configuration -> App settings -> Basics.
#
# This is public by design: it ships in the browser bundle, so it is an
# identifier, not a secret. The app *secret* is never set here — it belongs to
# the backend, and only if the backend verifies Privy JWTs.
#
# Use a development app. A production app ID sets its cookies only on a
# verified domain, so sign-in cannot persist on localhost.
NEXT_PUBLIC_PRIVY_APP_ID=

# Sanity-check whatever you paste — the JWKS endpoint doubles as a validator.
# A good id returns 200, a bad one 400 {"code":"missing_or_invalid_privy_app_id"}.
# A stray character or trailing space presents as sign-in mysteriously failing
# rather than as a bad value, so it is worth ten seconds:
#   curl -s -o /dev/null -w '%{http_code}\n' \
#     https://auth.privy.io/api/v1/apps/$NEXT_PUBLIC_PRIVY_APP_ID/jwks.json

# Optional, and only when the app has multiple app clients configured. Left
# commented out on purpose: an empty string is not a valid client ID, so the
# provider must not receive one.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Login methods — email, Google, wallets — are dashboard toggles, not env vars.
# Enable them under Configuration -> Login methods; nothing to fill in here.
# Google works on Privy's own OAuth credentials, so no Google Cloud project is
# needed. `config.loginMethods` in PrivyProvider then picks from what is on.

# Why there is no app secret here: the backend verifies a signature over a
# nonce, not a Privy JWT, so it needs no Privy credential at all. If that ever
# changes, the secret goes in backend/.env — never in this file, where every
# NEXT_PUBLIC_* value is compiled into the bundle each visitor downloads.
# See docs/prizes.md for the Privy constraints this project builds against.

# ─── Chain ──────────────────────────────────────────────────
# The browser signs and broadcasts its own transactions once the embedded
# wallet is the signer, so it needs the chain the backend already knows about.
# Pre-hydration bootstrap only: Privy needs supportedChains synchronously at mount,
# before GET /api/chain/config resolves. These MUST agree with what that endpoint
# reports — two anvil instances both answer to chain id 31337, so a mismatch does
# not error, it just signs against the wrong chain and reads an empty wallet.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8546
NEXT_PUBLIC_CHAIN_ID=31337
