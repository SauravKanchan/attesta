# Backend base URL. The client appends /api to this.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Privy ──────────────────────────────────────────────────
# Dashboard -> Configuration -> App settings -> Basics.
#
# This is public by design: it ships in the browser bundle, so it is an
# identifier, not a secret. The app *secret* is never set here — it belongs to
# the backend, and only if the backend verifies Privy JWTs.
#
# Use a development app. A production app ID sets its cookies only on a
# verified domain, so sign-in cannot persist on localhost.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional, and only when the app has multiple app clients configured. Left
# commented out on purpose: an empty string is not a valid client ID, so the
# provider must not receive one.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Login methods — email, Google, wallets — are dashboard toggles, not env vars.
# Enable them under Configuration -> Login methods; nothing to fill in here.
# Google works on Privy's own OAuth credentials, so no Google Cloud project is
# needed. `config.loginMethods` in PrivyProvider then picks from what is on.

# ─── Chain ──────────────────────────────────────────────────
# The browser signs and broadcasts its own transactions once the embedded
# wallet is the signer, so it needs the chain the backend already knows about.
# These mirror RPC_URL and CHAIN_ID in backend/.env.example.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
