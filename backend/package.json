{
	"name": "@attesta/backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"main": "dist/backend/src/index.js",
	"scripts": {
		"dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node --env-file-if-exists=.env dist/backend/src/index.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
		"db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
		"chain:abis": "node --env-file-if-exists=.env --import tsx src/chain/generate-abis.ts",
		"verify:chain": "node --env-file-if-exists=.env --import tsx src/chain/verify.ts",
		"verify:oracle": "node --env-file-if-exists=.env --import tsx src/oracle/verify.ts",
		"test": "node --import tsx --test test/*.test.ts"
	},
	"dependencies": {
		"@fastify/cors": "^11.0.1",
		"better-sqlite3": "^11.10.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.4.0",
		"viem": "^2.31.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.15.0",
		"drizzle-kit": "^0.31.1",
		"tsx": "^4.20.0",
		"typescript": "^5.8.3"
	}
}
