PORT=4000
DATABASE_URL=./data/attesta.db
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CORS_ORIGIN=http://localhost:3000

# Strategy subsystem — the submission pipeline and the enclave simulator.
# Every value below is the default; the backend runs with none of them set.
STRATEGY_WORKSPACE_DIR=./data/workflows
# Defaults to http://127.0.0.1:$PORT/api/oracle/prices. Must be reachable from a
# spawned cre process, which resolves it in its own network namespace.
# ORACLE_URL=http://127.0.0.1:4000/api/oracle/prices
CRE_ENABLED=true
CRE_TARGET=staging-settings
CRE_BUILD_TIMEOUT_MS=300000
CRE_SIMULATE_TIMEOUT_MS=300000
CRE_SCHEDULE=0 */1 * * * *
# USDC prefunded into each new vault's reserve so a gain is payable.
VAULT_RESERVE_USDC=250000

# Scheduler — the tick loop.
TICK_INTERVAL_MS=60000
SCHEDULER_CONCURRENCY=3
# Venue cost charged on turnover, bps. Matches the backtester's default.
TICK_FEE_BPS=30
TICK_HISTORY_LIMIT=128
SCHEDULER_ENABLED=true
