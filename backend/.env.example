PORT=4000
DATABASE_URL=./data/attesta.db
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CORS_ORIGIN=http://localhost:3000

# Strategy subsystem — the submission pipeline and the enclave simulator.
# Every value below is the default; the backend runs with none of them set.
STRATEGY_WORKSPACE_DIR=./data/workflows
# Defaults to http://127.0.0.1:$PORT/api/oracle/prices. Must be reachable from a
# spawned cre process, which resolves it in its own network namespace.
# ORACLE_URL=http://127.0.0.1:4000/api/oracle/prices
CRE_ENABLED=true
CRE_TARGET=staging-settings
CRE_BUILD_TIMEOUT_MS=300000
CRE_SIMULATE_TIMEOUT_MS=300000
CRE_SCHEDULE=0 */1 * * * *
# USDC prefunded into each new vault's reserve so a gain is payable.
VAULT_RESERVE_USDC=250000

# Scheduler — the tick loop.
TICK_INTERVAL_MS=60000
SCHEDULER_CONCURRENCY=3
# Venue cost charged on turnover, bps. Matches the backtester's default.
TICK_FEE_BPS=30
TICK_HISTORY_LIMIT=128
SCHEDULER_ENABLED=true

# ─── Privy ──────────────────────────────────────────────────
# Nothing reads these today. The backend authenticates a user by recovering the
# signer of a nonce it issued, so it never calls Privy and needs no credential
# from it. They are here for the day identity moves from the wallet address to
# the Privy DID. Background and the reasoning: docs/prizes.md.
#
# Setting a value here is not enough on its own — src/lib/env.ts parses
# process.env through a zod object schema, which drops any key it does not
# declare. Add the key there or `env` will never carry it.
#
# PRIVY_APP_ID is public. It is the audience claim on every Privy JWT and it
# already ships to the browser as NEXT_PUBLIC_PRIVY_APP_ID.
#
# PRIVY_APP_SECRET is a real secret: it authenticates this backend as your app.
# It must never cross into frontend/.env, where NEXT_PUBLIC_* is compiled into
# the bundle every visitor downloads. Rotate it in the dashboard if it leaks.
# It buys exactly one thing — calls to Privy's REST API, such as reading a
# user's linked accounts, because a verified token carries the DID (`sub`) and
# not the wallet address.
#
# There is deliberately no PRIVY_VERIFICATION_KEY. The dashboard offers a PEM
# public key for checking a token without an API round trip; use the JWKS
# endpoint instead:
#   https://auth.privy.io/api/v1/apps/$PRIVY_APP_ID/jwks.json
# Tokens are ES256, issuer "privy.io", audience the app id, so jose's
# createRemoteJWKSet + jwtVerify needs neither a secret nor @privy-io/node.
# The endpoint serves every signing key with a kid, so rotation is handled; a
# single pinned PEM starts rejecting valid tokens the moment Privy rotates.
# Established by probe, not read: those keys are EC P-256 / ES256. Some Privy
# docs pages call the verification key Ed25519, and a verifier built on that
# will not work.

# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
